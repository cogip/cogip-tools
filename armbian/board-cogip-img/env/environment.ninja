# CLASS=NINJA (ROBOT_ID=2). Pami-class services, Ninja geometry + GPIO pins,
# short-range lidar. No SC servos / starter. ROBOT_ID is the only build-time sub.

# General
VIRTUAL_ENV=/opt/.venv
COGIP_SOCKETIO_SERVER_URL=http://localhost:809ROBOT_ID
AVOIDANCE_DEBUG=0
PLANNER_DEBUG=0

# Copilot
COPILOT_CAN_CHANNEL=can0

# Planner
PLANNER_START_POSITION=NINJA
PLANNER_ROBOT_WIDTH=160
PLANNER_ROBOT_LENGTH=154
PLANNER_OBSTACLE_BB_MARGIN=0.2
PLANNER_BYPASS_DETECTOR=0
PLANNER_SCSERVOS_PORT=/dev/ttyACM0
PLANNER_SCSERVOS_BAUD_RATE=1000000
PLANNER_LED_RED_PIN=5
PLANNER_LED_GREEN_PIN=6
PLANNER_LED_BLUE_PIN=13
PLANNER_FLAG_MOTOR_PIN=18
PLANNER_OLED_BUS=1
PLANNER_OLED_ADDRESS=0x3C

# Detector
DETECTOR_LIDAR_PORT=/dev/ttyAMA4
DETECTOR_MIN_DISTANCE=30
DETECTOR_MAX_DISTANCE=300
DETECTOR_MIN_INTENSITY=30
DETECTOR_REFRESH_INTERVAL=0.1
DETECTOR_CLUSTER_MIN_SAMPLES=3
DETECTOR_CLUSTER_EPS=15.0
DETECTOR_SENSOR_DELAY=0

# MCU Logger
MCU_LOGGER_PORT=/dev/ttyAMA2

# Robotcam (Raspberry Pi Camera v2.1 / imx219, via picamera2/libcamera)
ROBOTCAM_NAME="rpicam"
ROBOTCAM_CODEC="yuyv"
ROBOTCAM_WIDTH=728
ROBOTCAM_HEIGHT=544
